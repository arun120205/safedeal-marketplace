{
  "info": {
    "name": "SafeDeal API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "1 - Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Arjun Kumar\",\n  \"email\": \"arjun@test.com\",\n  \"password\": \"password123\",\n  \"phone\": \"9876543210\",\n  \"address\": \"Chennai, Tamil Nadu\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/register", "host": ["{{base_url}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "2 - Login (auto-saves token!)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.token) {",
                  "    pm.collectionVariables.set('token', data.token);",
                  "    console.log('Token saved automatically! Use any request now.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"arjun@test.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "3 - Me (protected test)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{base_url}}/api/auth/me", "host": ["{{base_url}}"], "path": ["api", "auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "Listings",
      "item": [
        {
          "name": "4 - Create Listing (with photo)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "title", "value": "Redmi Note 12 5G", "type": "text" },
                { "key": "description", "value": "6 months old, box + bill available", "type": "text" },
                { "key": "category", "value": "ELECTRONICS", "type": "text" },
                { "key": "price", "value": "12500", "type": "text" },
                { "key": "conditionType", "value": "GOOD", "type": "text" },
                { "key": "billAvailable", "value": "true", "type": "text" },
                { "key": "image", "type": "file", "src": [] }
              ]
            },
            "url": { "raw": "{{base_url}}/api/listings", "host": ["{{base_url}}"], "path": ["api", "listings"] }
          }
        },
        {
          "name": "5 - Browse Listings",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/listings", "host": ["{{base_url}}"], "path": ["api", "listings"] }
          }
        },
        {
          "name": "6 - Get Listing by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/listings/1", "host": ["{{base_url}}"], "path": ["api", "listings", "1"] }
          }
        },
        {
          "name": "7 - My Listings",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{base_url}}/api/listings/my", "host": ["{{base_url}}"], "path": ["api", "listings", "my"] }
          }
        },
        {
          "name": "8 - Delete Listing",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{base_url}}/api/listings/1", "host": ["{{base_url}}"], "path": ["api", "listings", "1"] }
          }
        }
      ]
    }
  ]
}